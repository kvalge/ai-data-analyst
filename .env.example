# --- Ollama connection ---
OLLAMA_HOST=http://localhost:11434

# --- Models ---
# Primary: main model used for prompt-to-code / agent decisions
OLLAMA_MODEL_PRIMARY=model_name:tag

# Fast fallback: light, quick responses for simple prompts
OLLAMA_MODEL_FALLBACK_FAST=model_name:tag

# Agentic/escalation option: for harder or longer-horizon tasks
OLLAMA_MODEL_AGENTIC=model_name:tag

# Coding fallback: raw code generation (not for structured/JSON output)
OLLAMA_MODEL_CODING=model_name:tag

# --- Database (optional, for the DB data-access tool) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# --- App settings ---
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO