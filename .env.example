# .env.example

# --- Ollama connection ---
OLLAMA_HOST=http://localhost:11434
# Seconds to wait for /api/generate (slow model load can exceed this)
OLLAMA_TIMEOUT_S=120

# --- Models ---
# Primary: main model used for prompt-to-code / agent decisions
OLLAMA_MODEL_PRIMARY=model_name:tag

# Fast fallback: light, quick responses for simple prompts
OLLAMA_MODEL_FALLBACK_FAST=model_name:tag

# Agentic/escalation option: for harder or longer-horizon tasks
OLLAMA_MODEL_AGENTIC=model_name:tag

# Coding fallback: raw code generation (not for structured/JSON output)
OLLAMA_MODEL_CODING=model_name:tag

# --- Database (optional, for the DB data-access tool) ---
# The Postgres role must be read-only (SELECT only). The app does not enforce
# this — grant it in the database. Connection test uses DB_NAME + DB_USER.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# --- App paths ---
UPLOAD_DIR=./data/uploads
CONTEXT_DIR=./data/context
CACHE_DIR=./data/cache
ARTIFACT_DIR=./data/artifacts
CHECKPOINT_PATH=./data/checkpoints/graph.sqlite
# No LOG_DIR. Runtime logs go to a sibling of UPLOAD_DIR (default ./data/logs).

# --- Limits ---
# 50 MB
MAX_UPLOAD_BYTES=52428800
MAX_FULL_LOAD_ROWS=100000
SAMPLE_N_ROWS=50
SANDBOX_TIMEOUT_S=30
MAX_PROMPT_CHARS=8000
MAX_PROMPT_TURNS=8
MAX_ARTIFACTS=8
RAG_TOP_K=4
DB_CONNECT_TIMEOUT_S=5

# --- Logging ---
LOG_LEVEL=INFO
